# Copy to `.env` for local runs; the binary loads it at startup. Never commit `.env` or put real
# credentials here. Every variable is optional; the value shown is the default.

# Log filter: `warn,<crate>=info` style directives (https://docs.rs/tracing-subscriber).
# RUST_LOG=warn,cargo_testcache=info,cargo_testcache_core=info

# Log format, `text` or `json`. Also set by: --log-format
# CARGO_TESTCACHE_LOG_FORMAT=text

# `1` or `true` hashes every test executable in full instead of reusing digests remembered for
# files whose size, times and inode are unchanged. Also set by: --no-stat-cache
# CARGO_TESTCACHE_FULL_HASH=0
